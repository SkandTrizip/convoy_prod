[Unit]
Description=Convoy FastAPI backend
After=network.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=azureuser
Group=azureuser
WorkingDirectory=/home/azureuser/convoy_prod
Environment=PATH=/home/azureuser/convoy_prod/venv/bin
Environment=PORT=5050
EnvironmentFile=-/home/azureuser/convoy_prod/.env
ExecStart=/home/azureuser/convoy_prod/venv/bin/uvicorn server:app --host 0.0.0.0 --port 5050
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
