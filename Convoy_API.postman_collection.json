{
  "info": {
    "name": "Convoy API",
    "description": "Full Convoy backend API collection. Set `baseUrl` (default http://localhost:8000/api). After Send OTP, copy `otp` from response (dev mode) into the `otp` variable, then run Verify OTP to set `userId`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "mobile",
      "value": "+919876543210"
    },
    {
      "key": "otp",
      "value": "1234"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "searcherId",
      "value": ""
    },
    {
      "key": "vehicleId",
      "value": ""
    },
    {
      "key": "postId",
      "value": ""
    },
    {
      "key": "truckRouteId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "notificationId",
      "value": ""
    },
    {
      "key": "aadhaarRefId",
      "value": ""
    },
    {
      "key": "aadhaarNumber",
      "value": "655675523712"
    },
    {
      "key": "aadhaarOtp",
      "value": "111000"
    }
  ],
  "item": [
    {
      "name": "1. Health & Misc",
      "item": [
        {
          "name": "Root / Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/"
          }
        },
        {
          "name": "Get Truck Types",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/truck-types"
          }
        }
      ]
    },
    {
      "name": "2. Auth",
      "item": [
        {
          "name": "Send OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.otp) pm.collectionVariables.set('otp', json.otp);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"{{mobile}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/send-otp"
          }
        },
        {
          "name": "Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.user && json.user._id) pm.collectionVariables.set('userId', json.user._id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"{{mobile}}\",\n  \"otp\": \"{{otp}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/verify-otp"
          }
        }
      ]
    },
    {
      "name": "3. User",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/user/profile/{{userId}}"
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Driver\",\n  \"profilePhoto\": null\n}"
            },
            "url": "{{baseUrl}}/user/profile/{{userId}}"
          }
        },
        {
          "name": "Update Push Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pushToken\": \"ExponentPushToken[xxxxxxxxxxxxxxxxxxxxxx]\"\n}"
            },
            "url": "{{baseUrl}}/user/push-token/{{userId}}"
          }
        }
      ]
    },
    {
      "name": "4. Locations",
      "item": [
        {
          "name": "Search Locations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/locations/search?query=delhi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "locations",
                "search"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "delhi"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. KYC",
      "item": [
        {
          "name": "Send Aadhaar OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.refId) pm.collectionVariables.set('aadhaarRefId', json.refId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"aadhaarNumber\": \"{{aadhaarNumber}}\"\n}"
            },
            "url": "{{baseUrl}}/kyc/aadhaar/send-otp/{{userId}}"
          }
        },
        {
          "name": "Verify Aadhaar OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refId\": \"{{aadhaarRefId}}\",\n  \"otp\": \"{{aadhaarOtp}}\",\n  \"aadhaarNumber\": \"{{aadhaarNumber}}\"\n}"
            },
            "url": "{{baseUrl}}/kyc/aadhaar/verify/{{userId}}"
          }
        },
        {
          "name": "Submit KYC (Manual - under review)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"manual\",\n  \"data\": {\n    \"aadhaar\": \"123412341234\",\n    \"name\": \"Test Driver\"\n  },\n  \"aadhaarFrontImage\": \"base64-or-url-front\",\n  \"aadhaarBackImage\": \"base64-or-url-back\"\n}"
            },
            "url": "{{baseUrl}}/kyc/submit/{{userId}}"
          }
        },
        {
          "name": "Get KYC Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/kyc/status/{{userId}}"
          }
        }
      ]
    },
    {
      "name": "6. ULIP Verification",
      "item": [
        {
          "name": "Verify Vehicle (VAHAN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleNumber\": \"DL01AB1234\"\n}"
            },
            "url": "{{baseUrl}}/verification/vehicle/{{userId}}"
          }
        },
        {
          "name": "Verify DL (SARATHI)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dlnumber\": \"DL1420110012345\",\n  \"dob\": \"1990-08-15\"\n}"
            },
            "url": "{{baseUrl}}/verification/dl/{{userId}}"
          }
        },
        {
          "name": "Batch Verify DL + Vehicle",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documents\": [\n    {\n      \"type\": \"dl\",\n      \"data\": {\n        \"dlNumber\": \"DL1420110012345\",\n        \"dob\": \"1990-08-15\"\n      }\n    },\n    {\n      \"type\": \"vehicle\",\n      \"data\": {\n        \"vehicleNumber\": \"DL01AB1234\"\n      }\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/verification/batch/{{userId}}"
          }
        }
      ]
    },
    {
      "name": "7. Vehicles",
      "item": [
        {
          "name": "Add Vehicle",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.vehicle && json.vehicle._id) pm.collectionVariables.set('vehicleId', json.vehicle._id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleNumber\": \"MH12AB1234\",\n  \"truckType\": \"Container\",\n  \"capacity\": 20\n}"
            },
            "url": "{{baseUrl}}/vehicle/add/{{userId}}"
          }
        },
        {
          "name": "List Vehicles",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/vehicle/list/{{userId}}"
          }
        }
      ]
    },
    {
      "name": "7. Posts (Truck Listings)",
      "item": [
        {
          "name": "Create Post",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.post && json.post._id) {",
                  "  pm.collectionVariables.set('postId', json.post._id);",
                  "  pm.collectionVariables.set('truckRouteId', json.post._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleId\": \"{{vehicleId}}\",\n  \"origin\": {\n    \"name\": \"Delhi\",\n    \"lat\": 28.7041,\n    \"lng\": 77.1025,\n    \"type\": \"local\"\n  },\n  \"destinations\": [\n    {\n      \"name\": \"Mumbai\",\n      \"lat\": 19.076,\n      \"lng\": 72.8777,\n      \"type\": \"local\"\n    }\n  ],\n  \"currentLocation\": {\n    \"name\": \"Delhi\",\n    \"lat\": 28.7041,\n    \"lng\": 77.1025,\n    \"type\": \"local\"\n  },\n  \"price\": 45000,\n  \"contactName\": null,\n  \"contactNumber\": null\n}"
            },
            "url": "{{baseUrl}}/posts/create/{{userId}}"
          }
        },
        {
          "name": "My Posts (all)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/posts/my-posts/{{userId}}"
          }
        },
        {
          "name": "My Posts (active)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/my-posts/{{userId}}?status=active",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "my-posts",
                "{{userId}}"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "active"
                }
              ]
            }
          }
        },
        {
          "name": "My Posts (expired)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/my-posts/{{userId}}?status=expired",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "my-posts",
                "{{userId}}"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "expired"
                }
              ]
            }
          }
        },
        {
          "name": "Reactivate Post",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/posts/reactivate/{{postId}}"
          }
        },
        {
          "name": "Delete Post",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/posts/delete/{{postId}}"
          }
        }
      ]
    },
    {
      "name": "8. Search",
      "item": [
        {
          "name": "Search Trucks",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origin\": {\n    \"name\": \"Delhi\",\n    \"lat\": 28.7041,\n    \"lng\": 77.1025,\n    \"type\": \"local\"\n  },\n  \"destination\": {\n    \"name\": \"Mumbai\",\n    \"lat\": 19.076,\n    \"lng\": 72.8777,\n    \"type\": \"local\"\n  },\n  \"truckType\": \"Container\",\n  \"radius_km\": 150,\n  \"page\": 1,\n  \"capacity\": null\n}"
            },
            "url": "{{baseUrl}}/search/trucks"
          }
        },
        {
          "name": "Track Search Demand",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origin\": {\n    \"name\": \"Delhi\",\n    \"lat\": 28.7041,\n    \"lng\": 77.1025,\n    \"type\": \"local\"\n  },\n  \"destination\": {\n    \"name\": \"Mumbai\",\n    \"lat\": 19.0760,\n    \"lng\": 72.8777,\n    \"type\": \"local\"\n  },\n  \"truckType\": \"Container\"\n}"
            },
            "url": "{{baseUrl}}/search/track-demand/{{searcherId}}"
          }
        },
        {
          "name": "Log Call Click",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"postId\": \"{{postId}}\"\n}"
            },
            "url": "{{baseUrl}}/search/log-call/{{searcherId}}"
          }
        }
      ]
    },
    {
      "name": "10. Bookings",
      "item": [
        {
          "name": "Create Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.booking && json.booking._id) pm.collectionVariables.set('bookingId', json.booking._id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"truck_route_id\": \"{{truckRouteId}}\",\n  \"price\": 45000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/bookings?user_id={{searcherId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings"
              ],
              "query": [
                {
                  "key": "user_id",
                  "value": "{{searcherId}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "11. Notifications",
      "item": [
        {
          "name": "Get Notifications",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.notifications && json.notifications[0]) pm.collectionVariables.set('notificationId', json.notifications[0]._id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/notifications/{{userId}}"
          }
        },
        {
          "name": "Mark Notification Read",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/notifications/mark-read/{{notificationId}}"
          }
        }
      ]
    },
    {
      "name": "12. Admin",
      "item": [
        {
          "name": "Get Pending KYC",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/admin/kyc/pending"
          }
        },
        {
          "name": "KYC Approve",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"action\": \"approve\"\n}"
            },
            "url": "{{baseUrl}}/admin/kyc/action"
          }
        },
        {
          "name": "KYC Reject",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"action\": \"reject\",\n  \"reason\": \"Document unclear\"\n}"
            },
            "url": "{{baseUrl}}/admin/kyc/action"
          }
        },
        {
          "name": "Analytics Dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/admin/analytics"
          }
        },
        {
          "name": "Delete User (DESTRUCTIVE)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Admin-Key",
                "value": "{{adminApiKey}}"
              }
            ],
            "url": "{{baseUrl}}/admin/users/delete/{{userId}}"
          }
        }
      ]
    },
    {
      "name": "13. History",
      "item": [
        {
          "name": "Recent Posts",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/history?type=post"
          }
        },
        {
          "name": "Recent Searches",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/history?type=search"
          }
        }
      ]
    }
  ]
}
